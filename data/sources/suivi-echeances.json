        "en": "Loan category identifier"
      }
    },
    {
      "name": "CategoryDesc",
      "type": "string",
      "description": {
        "fr": "Intitulé de la catégorie du prêt",
        "en": "Loan category label"
      }
    },
    {
      "name": "ClientName",
      "type": "string",
      "description": {
